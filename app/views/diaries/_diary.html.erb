<div class="diary">
  <div class="diary-header">
    <h2 class="diary-date"><%= l(diary.date, format: :diary) %></h2>
    <% if current_user == diary.user %>
      <p class="diary-visibility">
        <%= t("visibility.#{diary.visibility}") %>
      </p>
    <% end %>
  </div>

  <% diary.diary_entries.each do |entry| %>
    <%= render "diaries/diary_entry", entry: entry %>
  <% end %>
</div>
