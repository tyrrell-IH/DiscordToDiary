<div class="diary-list">
  <%= render "diaries/owner", user: @user %>

  <div class="diary-list-header">
    <% if @diary_date %>
      <h1 class="diary-month">
        <%= l(@diary_date, format: :month) %>
      </h1>
    <% end %>

    <% if @diary_months.any? %>
      <%= form_with url: user_diaries_path(@user),
                    method: :get,
                    class: "diary-month-form" do |form| %>
        <%= form.label :diary_month, "表示する年月",
                       class: "diary-month-label" %>

        <%= form.select :diary_month,
                        @diary_months.map { |month|
                          [l(month, format: :month_select), month.strftime("%Y-%m")]
                        },
                        {
                          selected: @diary_date&.strftime("%Y-%m"),
                          include_blank: "年月を選択"
                        },
                        { class: "diary-month-select" } %>

        <%= form.submit "表示", name: nil,  class: "diary-month-submit" %>
      <% end %>
    <% end %>
  </div>

  <% if @diaries.empty? %>
    <p>日記がありません。</p>
  <% else %>
    <% @diaries.each do |diary| %>
      <%= render "diaries/diary", diary: diary %>
    <% end %>
  <% end %>
</div>
