<div class="diary-detail">
  <%= render "diaries/owner", user: @user %>

  <div class="diary">
    <header class="diary-header">
      <h1 class="diary-date">
        <%= l(@diary.date, format: :diary) %>
      </h1>
    </header>

    <div class="diary-detail-entries">
      <% @diary.diary_entries.each do |entry| %>
        <div class="diary-detail-entry">
          <%= render "diaries/diary_entry", entry: entry %>
        </div>
      <% end %>
    </div>
  </div>
</div>

